# Copia este fichero a .env y descomenta lo que quieras cambiar.
# Las variables de entorno reales tienen prioridad sobre .env.
# Nunca pongas secretos aquí: van en keyring.

# TRASNO_DATA_DIR=data
# TRASNO_USER_ID=1
# TRASNO_VENTANA_MADRUGADA=["00:00", "06:00"]
# TRASNO_BACKUP_DIR=backups
# TRASNO_BACKUP_RETENCION_DIAS=30
# TRASNO_TIMEZONE=Europe/Madrid
# TRASNO_BRIEFING_HORA=07:30
# TRASNO_SCHEDULER_ACTIVO=true
# LLM del agente (API compatible con OpenAI). Por defecto, Ollama en local:
# TRASNO_LLM_URL=http://localhost:11434/v1
# TRASNO_LLM_MODELO=qwen3:8b
# Groq (la clave va en keyring: keyring set trasno llm):
# TRASNO_LLM_URL=https://api.groq.com/openai/v1
# TRASNO_LLM_MODELO=openai/gpt-oss-120b
